# ============================================================================
# ISA (Intelligent Secretary Assistant) - Environment Configuration
# ============================================================================

# --- Air-Gapped / Offline Enforcement ---
OLLAMA_NO_CLOUD=1
OLLAMA_NO_UPDATE_CHECK=1
OLLAMA_HOST=127.0.0.1:11434
COPILOT_OFFLINE=true
OPENCODE_AIRGAPPED=1

# --- Local LLM Inference (Ollama / OpenAI-compatible) ---
ISA_LLM_BASE_URL=http://127.0.0.1:11434/v1
ISA_LLM_MODEL=gemma4:12b
ISA_LLM_NUM_CTX=8192

# --- Obsidian Local REST API ---
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=your_obsidian_local_rest_api_key_here
OBSIDIAN_VERIFY_SSL=false

# --- Vault & File Monitoring (Watchdog) ---
OBSIDIAN_VAULT_PATH=/path/to/your/ObsidianVault
ISA_INBOX_FILENAME=ISA_Inbox.md
ISA_ACTIVE_TASKS_FILENAME=Tasks.md
ISA_DEBOUNCE_SECONDS=1.0

# --- Semantic Memory (LanceDB & Local Embeddings) ---
LANCEDB_URI=./data/lancedb
ISA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ISA_RRF_K=60
